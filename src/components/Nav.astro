---
import Logo from './Logo.astro';
import {LANGUAGES, localePath, otherLocale, toLocale} from '../i18n';
import {getDictionary} from '../i18n/ui';

export interface Props {
    /** This page in the other language, for the language switch. */
    alternatePath: string;
}

const {alternatePath} = Astro.props;
const locale = toLocale(Astro.currentLocale);
const other = LANGUAGES[otherLocale(locale)];
const t = getDictionary(locale);

// Absolute anchors so the nav also works from the legal pages and the 404 page.
const links = [
    {hash: 'about', label: t.nav.about},
    {hash: 'journey', label: t.nav.journey},
    {hash: 'shows', label: t.nav.shows},
    {hash: 'music', label: t.nav.music},
    {hash: 'gallery', label: t.nav.gallery},
].map(({hash, label}) => ({href: localePath(locale, `/#${hash}`), label}));
const homeHref = localePath(locale, '/');
const bookHref = localePath(locale, '/#contact');

const socials = [
    {href: 'https://www.instagram.com/dj_ian_kita/', label: 'Instagram'},
    {href: 'https://soundcloud.com/iankitadj', label: 'SoundCloud'},
    {href: 'https://open.spotify.com/artist/5O53OdbKPbycjdfysY4Oyt', label: 'Spotify'},
];
---

<header class="site-nav fixed inset-x-0 top-0 z-50 border-b border-transparent" data-nav>
    <div class="flex h-16 items-center justify-between px-page lg:h-20">
        <a href={homeHref} class="text-swiss-white transition-colors hover:text-accent no-underline"
           aria-label={t.nav.home}>
            <Logo class="h-[13px] w-auto min-[400px]:h-[15px] lg:h-[18px]" decorative/>
        </a>

        <nav class="hidden items-center gap-9 lg:flex" aria-label={t.nav.primary}>
            {links.map((link) => (
                    <a href={link.href}
                       class="eyebrow text-swiss-white/70 transition-colors hover:text-swiss-white no-underline">{link.label}</a>
            ))}
        </nav>

        <div class="flex items-center gap-1.5 sm:gap-3">
            {/* Links to this page in the other language; setupLanguageSwitch adds
                the section being read, so the reader lands in the same place. */}
            <a
                    href={alternatePath}
                    hreflang={other.hreflang}
                    lang={other.hreflang}
                    aria-label={other.name}
                    class="px-2 py-2.5 eyebrow text-swiss-white/70 transition-colors hover:text-swiss-white no-underline max-[359px]:hidden"
                    data-language-switch
            >
                {other.code}
            </a>
            <a
                    href={bookHref}
                    class="inline-flex items-center gap-1.5 rounded-full border border-white/20 px-3.5 py-2.5 eyebrow text-swiss-white transition-colors hover:border-accent hover:text-accent active:scale-[0.97] no-underline sm:gap-2 sm:px-5"
            >
                <span class="pulse-dot hidden h-1.5 w-1.5 rounded-full bg-accent sm:block"></span>
                {t.nav.book}
            </a>
            <button
                    type="button"
                    class="inline-flex items-center rounded-full border border-white/20 px-3.5 py-2.5 eyebrow text-swiss-white transition-colors hover:border-white/50 active:scale-[0.97] sm:px-4 lg:hidden"
                    aria-expanded="false"
                    aria-controls="menu"
                    data-menu-toggle
                    data-label-open={t.nav.menu}
                    data-label-close={t.nav.close}
            >
                {t.nav.menu}
            </button>
        </div>
    </div>
</header>

<div id="menu" class="menu-overlay lg:hidden" hidden>
    <nav aria-label={t.nav.mobile}>
        <ul class="m-0 list-none p-0">
            {links.map((link) => (
                    <li class="border-b border-white/10">
                        <a
                                href={link.href}
                                class="block py-5 font-heading text-4xl font-medium tracking-tight text-swiss-white no-underline transition-colors hover:text-accent sm:text-5xl"
                        >
                            {link.label}
                        </a>
                    </li>
            ))}
            <li class="border-b border-white/10">
                <a
                        href={bookHref}
                        class="block py-5 font-heading text-4xl font-medium tracking-tight text-accent no-underline sm:text-5xl"
                >
                    {t.nav.book}
                </a>
            </li>
        </ul>
    </nav>
    <div class="mt-12 flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-wrap gap-x-6 gap-y-2 eyebrow text-swiss-white/60">
            <a href={alternatePath} hreflang={other.hreflang} lang={other.hreflang}
               class="text-swiss-white hover:text-accent no-underline" data-language-switch>{other.name}</a>
            {socials.map((s) => (
                    <a href={s.href} target="_blank" rel="noopener noreferrer"
                       class="hover:text-swiss-white no-underline">{s.label}</a>
            ))}
        </div>
        <Logo class="h-4 w-auto text-swiss-white/40" decorative/>
    </div>
</div>
