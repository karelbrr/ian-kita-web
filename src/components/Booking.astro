---
<footer id="contact" class="reveal bg-swiss-white text-swiss-black py-24 lg:py-40">
    <div class="px-6 md:px-12 lg:px-24">
        <div class="flex flex-col gap-8 mb-20 lg:mb-32">
            <h2 class="font-heading font-medium text-sm uppercase tracking-widest text-swiss-black/60">Get in touch</h2>
            <a href="mailto:booking@iankita.com"
               class="font-heading font-bold text-4xl sm:text-6xl lg:text-8xl tracking-tighter leading-[0.95] text-swiss-black hover:text-swiss-red transition-colors no-underline break-all sm:break-normal">booking@iankita.com</a>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-16">
            <div class="flex flex-wrap gap-x-8 gap-y-3 font-heading text-base uppercase tracking-widest text-swiss-black/60">
                <a href="https://www.instagram.com/dj_ian_kita/" target="_blank" rel="noopener noreferrer"
                   aria-label="Follow Ian Kita on Instagram"
                   class="hover:text-swiss-red focus-visible:outline-none focus-visible:text-swiss-red focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-white rounded-sm transition-colors no-underline">Instagram</a>
                <a href="https://soundcloud.com/iankitadj" target="_blank" rel="noopener noreferrer"
                   aria-label="Listen to Ian Kita on SoundCloud"
                   class="hover:text-swiss-red focus-visible:outline-none focus-visible:text-swiss-red focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-white rounded-sm transition-colors no-underline">Soundcloud</a>
                <a href="https://open.spotify.com/artist/5O53OdbKPbycjdfysY4Oyt?si=i68QwYC9T7-xU-7hnZkcrQ"
                   target="_blank" rel="noopener noreferrer" aria-label="Listen to Ian Kita on Spotify"
                   class="hover:text-swiss-red focus-visible:outline-none focus-visible:text-swiss-red focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-white rounded-sm transition-colors no-underline">Spotify</a>
            </div>
            <span class="font-heading text-sm uppercase tracking-widest text-swiss-black/40">Zlín, CZ</span>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs font-sans text-swiss-black/60 pt-8 border-t-[1px] border-black/10">
            <p>&copy; {new Date().getFullYear()} Ian Kita. All rights reserved.</p>
            <div class="flex gap-6">
                <a href="/privacy-policy" class="hover:text-swiss-black transition-colors underline">Privacy
                    Policy</a>
                <a href="/terms" class="hover:text-swiss-black transition-colors underline">Terms of Service</a>
                <span>Made by <a
                        href="https://karelbraborec.com" target="_blank" rel="noopener noreferrer"
                        aria-label="Karel Braborec's website"
                        class="hover:text-swiss-black transition-colors underline">karelbraborec.com</a></span>

            </div>
        </div>
    </div>
</footer>
