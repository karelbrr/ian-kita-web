---
import SectionShell from "./SectionShell.astro";
import { shows as SHOWS } from "../data/upcoming-shows.json";

const todayISO = new Date().toISOString().slice(0, 10);
const shows = SHOWS.filter((show) => show.date >= todayISO);

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

// show.date is an ISO string ("2026-10-15"); parse as UTC to avoid the local
// timezone shifting the displayed day by ±1.
function parseShowDate(date: string) {
  const parsed = new Date(`${date}T00:00:00Z`);
  return { day: String(parsed.getUTCDate()).padStart(2, "0"), month: MONTHS[parsed.getUTCMonth()] };
}
---
<SectionShell id="gigs" heading="Upcoming Shows">
      {shows.length === 0 ? (
        <p class="font-sans text-swiss-white/60 text-lg border-t-[1px] border-white/10 pt-6">
          No upcoming shows right now — check back soon.
        </p>
      ) : (
      <ul class="list-none p-0 m-0 border-t-[1px] border-white/10">
        {shows.map((show, i) => {
          const { day, month } = parseShowDate(show.date);
          return (
            <li
              tabindex="0"
              class={`group flex items-center gap-5 lg:gap-8 py-6 px-4 -mx-4 border-b-[1px] border-white/10 border-l-2 ${i === 0 ? 'border-l-swiss-red bg-swiss-red/[0.03]' : 'border-l-transparent'} transition-colors hover:bg-white/[0.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-black rounded-sm`}
            >
              <div class="flex flex-col items-center justify-center w-16 h-16 lg:w-20 lg:h-20 shrink-0 border border-white/10 rounded-sm group-hover:border-swiss-red/40 transition-colors">
                <span class="font-heading text-2xl lg:text-3xl font-bold text-swiss-white leading-none">{day}</span>
                <span class="font-heading text-[10px] lg:text-xs uppercase tracking-widest text-swiss-white/50 mt-1">{month}</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-3 mb-1">
                  <span class="font-sans font-medium text-xl lg:text-2xl text-swiss-white group-hover:text-swiss-red group-focus-visible:text-swiss-red transition-colors">{show.venue}</span>
                  {i === 0 && (
                    <span class="text-[10px] font-heading font-medium uppercase tracking-widest text-swiss-red border border-swiss-red/40 rounded-full px-2 py-0.5">Next</span>
                  )}
                </div>
                <span class="font-sans text-swiss-white/60 text-sm lg:text-base">{show.location}</span>
              </div>
              <span class="hidden md:block text-swiss-red text-xl opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 transition-all shrink-0">→</span>
            </li>
          );
        })}
      </ul>
      )}
</SectionShell>
