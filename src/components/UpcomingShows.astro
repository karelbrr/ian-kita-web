---
import { Image } from 'astro:assets';
import { shows as SHOWS } from '../data/upcoming-shows.json';
import photo from '../assets/photos/machac-2026-lake.jpg';
import { pick, toLocale } from '../i18n';
import { getDictionary } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = getDictionary(locale);

// Shows are in the Czech Republic, so "today" is Prague's calendar day, both
// here at build time and in the browser (setupShows hides dates that passed
// since the last build). en-CA formats dates as YYYY-MM-DD.
const TIME_ZONE = 'Europe/Prague';
const todayISO = new Intl.DateTimeFormat('en-CA', { timeZone: TIME_ZONE }).format(new Date());
const shows = [...SHOWS].filter((show) => show.date >= todayISO).sort((a, b) => a.date.localeCompare(b.date));

const monthFormat = new Intl.DateTimeFormat(locale === 'cs' ? 'cs' : 'en-US', { month: 'short', timeZone: 'UTC' });

// show.date is an ISO string ("2026-10-15"); parse as UTC to avoid the local
// timezone shifting the displayed day by ±1.
function parseShowDate(date: string) {
    const parsed = new Date(`${date}T00:00:00Z`);
    return {
        day: String(parsed.getUTCDate()).padStart(2, '0'),
        month: monthFormat.format(parsed),
        year: parsed.getUTCFullYear(),
    };
}
---

<section id="shows" class="reveal px-page py-24 lg:py-40">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="order-2 lg:order-1 lg:col-span-5">
            <figure class="relative m-0 aspect-[3/4] overflow-hidden rounded-sm bg-ink lg:sticky lg:top-28">
                <Image
                    src={photo}
                    alt={t.shows.photoAlt}
                    widths={[480, 800, 1200, 1365]}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-swiss-black/60 via-transparent to-transparent"></div>
                <figcaption class="absolute bottom-4 left-4 flex items-center gap-2 eyebrow text-swiss-white/80">
                    Mácháč 2026
                </figcaption>
            </figure>
        </div>

        <div class="order-1 lg:order-2 lg:col-span-7">
            <p class="eyebrow mb-8 text-accent">{t.shows.label}</p>
            <h2 class="mb-12 font-heading text-3xl font-medium leading-[1.05] tracking-tight text-swiss-white sm:text-4xl lg:text-5xl">
                {t.shows.heading}
            </h2>

            <p class="border-t border-white/10 pt-6 text-lg text-swiss-white/60" hidden={shows.length > 0} data-shows-empty>
                {t.shows.emptyBefore}<a href="#contact" class="text-swiss-white underline">{t.shows.emptyLink}</a>{t.shows.emptyAfter}
            </p>
            {shows.length > 0 && (
                <ul class="stagger -mx-4 m-0 list-none border-t border-white/10 p-0" data-shows data-time-zone={TIME_ZONE}>
                    {shows.map((show) => {
                        const { day, month, year } = parseShowDate(show.date);
                        // The first row is the next show: highlighted and badged via
                        // :first-child, so it stays right when past rows are removed.
                        return (
                            <li
                                class="group flex items-center gap-5 border-b border-l-2 border-white/10 border-l-transparent px-4 py-6 transition-colors first:border-l-accent first:bg-accent/[0.04] hover:bg-white/[0.03] lg:gap-8 lg:py-7"
                                data-show-date={show.date}
                            >
                                <time
                                    datetime={show.date}
                                    class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-sm border border-white/10 lg:h-20 lg:w-20"
                                >
                                    <span class="font-heading text-2xl font-bold leading-none tabular-nums text-swiss-white lg:text-3xl">{day}</span>
                                    <span class="mt-1 eyebrow text-xs text-swiss-white/50">{month}</span>
                                </time>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex flex-wrap items-center gap-3">
                                        <span class="font-heading text-xl font-medium tracking-tight text-swiss-white lg:text-3xl">{show.venue}</span>
                                        <span class="hidden border border-accent/50 px-1.5 py-0.5 eyebrow text-accent group-first:inline-block">{t.shows.next}</span>
                                    </div>
                                    <span class="text-sm text-swiss-white/60 lg:text-base">{pick(locale, show.location, show.location_cs)} · {year}</span>
                                </div>
                            </li>
                        );
                    })}
                </ul>
            )}
        </div>
    </div>
</section>
