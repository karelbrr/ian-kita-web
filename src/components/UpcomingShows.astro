---
import { Image } from 'astro:assets';
import { shows as SHOWS } from '../data/upcoming-shows.json';
import photo from '../assets/photos/machac-2026-lake.jpg';

const todayISO = new Date().toISOString().slice(0, 10);
const shows = [...SHOWS].filter((show) => show.date >= todayISO).sort((a, b) => a.date.localeCompare(b.date));

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

// show.date is an ISO string ("2026-10-15"); parse as UTC to avoid the local
// timezone shifting the displayed day by ±1.
function parseShowDate(date: string) {
    const parsed = new Date(`${date}T00:00:00Z`);
    return {
        day: String(parsed.getUTCDate()).padStart(2, '0'),
        month: MONTHS[parsed.getUTCMonth()],
        year: parsed.getUTCFullYear(),
    };
}
---

<section id="shows" class="reveal px-6 py-24 md:px-12 lg:px-24 lg:py-40">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="order-2 lg:order-1 lg:col-span-5">
            <figure class="relative m-0 aspect-[3/4] overflow-hidden rounded-sm bg-ink lg:sticky lg:top-28">
                <Image
                    src={photo}
                    alt="Ian Kita playing above the lake at Mácháč 2026"
                    widths={[480, 800, 1200, 1365]}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-swiss-black/60 via-transparent to-transparent"></div>
                <figcaption class="absolute bottom-4 left-4 flex items-center gap-2 eyebrow text-swiss-white/80">
                    <span class="glyph-square text-accent"></span>
                    Mácháč 2026
                </figcaption>
            </figure>
        </div>

        <div class="order-1 lg:order-2 lg:col-span-7">
            <p class="eyebrow mb-8 text-accent">Shows</p>
            <h2 class="mb-12 font-heading text-3xl font-medium leading-[1.05] tracking-tight text-swiss-white sm:text-4xl lg:text-5xl">
                Upcoming shows
            </h2>

            {shows.length === 0 ? (
                <p class="border-t border-white/10 pt-6 text-lg text-swiss-white/60">
                    No upcoming shows right now — check back soon or <a href="#contact" class="text-swiss-white underline">book a date</a>.
                </p>
            ) : (
                <ul class="stagger m-0 list-none border-t border-white/10 p-0">
                    {shows.map((show, i) => {
                        const { day, month, year } = parseShowDate(show.date);
                        return (
                            <li
                                class:list={[
                                    'group -mx-4 flex items-center gap-5 border-b border-l-2 border-white/10 px-4 py-6 transition-colors hover:bg-white/[0.03] lg:gap-8 lg:py-7',
                                    i === 0 ? 'border-l-accent bg-accent/[0.04]' : 'border-l-transparent',
                                ]}
                            >
                                <time
                                    datetime={show.date}
                                    class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-sm border border-white/10 transition-colors group-hover:border-accent/50 lg:h-20 lg:w-20"
                                >
                                    <span class="font-heading text-2xl font-bold leading-none text-swiss-white lg:text-3xl">{day}</span>
                                    <span class="mt-1 eyebrow text-[10px] text-swiss-white/50">{month}</span>
                                </time>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex flex-wrap items-center gap-3">
                                        <span class="font-heading text-xl font-medium tracking-tight text-swiss-white transition-colors group-hover:text-accent lg:text-3xl">{show.venue}</span>
                                        {i === 0 && (
                                            <span class="rounded-full border border-accent/40 px-2 py-0.5 eyebrow text-[10px] text-accent">Next</span>
                                        )}
                                    </div>
                                    <span class="text-sm text-swiss-white/60 lg:text-base">{show.location} · {year}</span>
                                </div>
                                <span class="hidden shrink-0 -translate-x-2 text-xl text-accent opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100 md:block">→</span>
                            </li>
                        );
                    })}
                </ul>
            )}

            <p class="mt-10 flex items-center gap-3 eyebrow text-swiss-white/40">
                <span class="glyph-square"></span>
                Want Ian on your line-up? <a href="#contact" class="text-swiss-white/70 transition-colors hover:text-swiss-white">Get in touch →</a>
            </p>
        </div>
    </div>
</section>
