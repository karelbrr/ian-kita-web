---
import {Image, getImage} from 'astro:assets';
import {images} from '../data/gallery.json';
import {resolvePhoto} from '../lib/photos';
import Arrow from './Arrow.astro';
import {pick, toLocale} from '../i18n';
import {getDictionary} from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = getDictionary(locale);

// Justified rows: every photo keeps its real proportions, the photos in a row
// share one height and the row fills the width, so any number of photos packs
// without holes. Photos read left to right in CMS order, the same order the
// lightbox steps through. Photos the CMS references from outside src/assets
// fall back to a plain <img> in a square tile.
const items = await Promise.all(
    images.map(async (image) => {
        const photo = resolvePhoto(image.url);
        const full = photo ? await getImage({
            src: photo,
            width: Math.min(photo.width, 2000),
            format: 'webp'
        }) : undefined;
        const ratio = photo ? Math.round((photo.width / photo.height) * 1000) / 1000 : 1;
        return {
            ...image,
            alt: pick(locale, image.alt, image.alt_cs),
            caption: pick(locale, image.caption, image.caption_cs),
            photo,
            fullSrc: full?.src ?? image.url,
            ratio,
        };
    }),
);

// The rest wait behind "Show all", so the section stays a section as photos
// are added. Without JavaScript every photo shows.
const FIRST_PHOTOS = 10;
---

<section id="gallery" class="reveal border-t border-white/10 px-page py-24 lg:py-40">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end lg:mb-16">
        <div>
            <p class="eyebrow mb-8 text-accent">{t.gallery.label}</p>
            <h2 class="m-0 font-heading text-3xl font-medium leading-[1.05] tracking-tight text-swiss-white sm:text-4xl lg:text-5xl">
                {t.gallery.heading}
            </h2>
        </div>
    </div>

    <div class="gallery-rows" data-gallery>
        {items.map((item, i) => (
                <a
                        href={item.fullSrc}
                        class:list={['gallery-rows__tile group relative block overflow-hidden rounded-sm bg-ink no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70', {'gallery-rows__extra': i >= FIRST_PHOTOS}]}
                        style={`--ratio: ${item.ratio}`}
                        data-lightbox
                        data-caption={item.caption}
                        data-alt={item.alt}
                        aria-label={t.gallery.openPhoto(item.caption)}
                >
                    {item.photo ? (
                            <Image
                                    src={item.photo}
                                    alt={item.alt}
                                    widths={[400, 800, 1200]}
                                    sizes={`(min-width: 1024px) ${Math.round(item.ratio * 420)}px, (min-width: 768px) ${Math.round(item.ratio * 340)}px, ${Math.round(item.ratio * 230)}px`}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                    loading="lazy"
                            />
                    ) : (
                            <img src={item.url} alt={item.alt} loading="lazy"
                                 class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"/>
                    )}
                    <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-2 bg-gradient-to-t from-swiss-black/80 to-transparent p-3 pt-8 eyebrow text-swiss-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 pointer-coarse:opacity-100 sm:p-4 sm:pt-10">
                    <span class="glyph-square shrink-0 text-accent"></span>
                    <span class="truncate">{item.caption}</span>
                </span>
                </a>
        ))}
        <span class="gallery-rows__filler" aria-hidden="true"></span>
    </div>

    {items.length > FIRST_PHOTOS && (
            <button type="button"
                    class="mx-auto mt-10 flex rounded-full border border-white/25 px-5 py-3 eyebrow text-swiss-white transition-colors hover:border-accent hover:text-accent active:scale-[0.97] lg:mt-14"
                    hidden data-gallery-more>{t.gallery.showAll(items.length)}
            </button>
    )}
</section>

<dialog class="lightbox" data-lightbox-dialog aria-label={t.gallery.viewer}>
    <span class="lightbox__spinner" aria-hidden="true"></span>
    <div class="flex h-full w-full flex-col items-center justify-center gap-5 p-4 sm:p-8">
        <figure class="m-0 flex flex-col items-center gap-4">
            <img class="lightbox__img rounded-sm" src="" alt="" data-lightbox-img/>
            <figcaption class="flex items-center gap-4 eyebrow text-swiss-white/70">
                <span data-lightbox-counter></span>
                <span class="glyph-square text-accent"></span>
                <span data-lightbox-caption></span>
            </figcaption>
        </figure>
    </div>
    <button type="button"
            class="absolute right-4 top-4 rounded-full border border-white/25 px-4 py-2.5 eyebrow text-swiss-white transition-colors hover:border-accent hover:text-accent active:scale-[0.97] sm:right-8 sm:top-8"
            data-lightbox-close>{t.gallery.close}
    </button>
    <button type="button"
            class="absolute left-2 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/25 text-swiss-white transition-colors hover:border-accent hover:text-accent active:scale-[0.97] sm:left-6"
            aria-label={t.gallery.previous} data-lightbox-prev>
        <Arrow direction="left" class="h-5 w-5" />
    </button>
    <button type="button"
            class="absolute right-2 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/25 text-swiss-white transition-colors hover:border-accent hover:text-accent active:scale-[0.97] sm:right-6"
            aria-label={t.gallery.next} data-lightbox-next>
        <Arrow direction="right" class="h-5 w-5" />
    </button>
</dialog>
