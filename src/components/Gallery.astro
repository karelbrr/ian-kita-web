---
import SectionShell from "./SectionShell.astro";
import { images } from "../data/gallery.json";
---
<SectionShell id="gallery" heading="Archive">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-8">
                {images.map(img => (
                        <div class="aspect-square bg-[#111] overflow-hidden rounded-sm">
                            <img src={img.url} alt={img.alt}
                                 class="w-full h-full object-cover grayscale contrast-125 opacity-90 hover:opacity-100 transition-opacity"
                                 loading="lazy"/>
                        </div>
                ))}
            </div>
</SectionShell>
