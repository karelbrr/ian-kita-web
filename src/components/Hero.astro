<header
        class="relative col-span-1 lg:col-span-12 flex flex-col justify-between gap-12 lg:gap-0 h-auto lg:h-[55vh] pt-8 lg:pt-16"
>
    <div>
        <div class="flex items-stretch justify-between">
            <h1
                    class="animate-load -ml-[0.06em] font-heading font-bold text-6xl sm:text-7xl lg:text-[15vw] tracking-tighter leading-[0.9] lg:leading-[0.8] text-swiss-white uppercase"
            >
                Ian Kita
            </h1>
            <nav
                    class="hidden lg:flex flex-col items-end justify-between py-2 text-sm font-heading font-medium uppercase tracking-widest text-swiss-white"
                    aria-label="Section navigation"
            >
                <a href="#about" class="animate-load hover:text-swiss-red transition-colors no-underline"
                   style="animation-delay: 400ms">About</a>
                <a href="#gigs" class="animate-load hover:text-swiss-red transition-colors no-underline"
                   style="animation-delay: 450ms">Gigs</a>
                <a href="#tracks" class="animate-load hover:text-swiss-red transition-colors no-underline"
