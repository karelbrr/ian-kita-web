---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import stage from '../assets/hero-stage-clean.jpg';
import about from '../data/about.json';
import { shows as SHOWS } from '../data/upcoming-shows.json';

const todayISO = new Date().toISOString().slice(0, 10);
const nextShow = [...SHOWS].filter((show) => show.date >= todayISO).sort((a, b) => a.date.localeCompare(b.date))[0];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function formatShort(date: string) {
    const parsed = new Date(`${date}T00:00:00Z`);
    return `${parsed.getUTCDate()} ${MONTHS[parsed.getUTCMonth()]}`;
}
---

<section id="top" class="hero relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-swiss-black">
    <div class="absolute inset-0" aria-hidden="true">
        <!-- On large screens the photo is enlarged from its bottom edge so the DJ
             (centre of the frame) rises into the middle of the viewport, clear of
             the logotype that sits over the darkened lower third. -->
        <div class="absolute inset-0 origin-bottom scale-[1.12] lg:scale-[1.32]">
            <Image
                src={stage}
                alt=""
                widths={[640, 960, 1440, 2048]}
                sizes="100vw"
                class="hero__img h-full w-full object-cover object-[50%_100%]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
        <div class="absolute inset-x-0 top-0 h-2/5 bg-gradient-to-b from-swiss-black/80 via-swiss-black/35 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-swiss-black via-swiss-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-swiss-black/40 via-transparent to-swiss-black/30"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-brand-plum/45 to-transparent"></div>
    </div>

    <div class="hero-parallax relative z-10 px-6 pt-40 pb-8 md:px-12 lg:px-24 lg:pb-12">
        <p class="animate-blur-up eyebrow mb-6 flex items-center gap-3 text-swiss-white/70" style="animation-delay: 1100ms">
            <span class="glyph-square text-accent"></span>
            {about.eyebrow}
        </p>

        <h1 class="m-0 text-swiss-white">
            <span class="sr-only">Ian Kita</span>
            <Logo variant="draw" class="block h-auto w-full" decorative />
        </h1>

        <div class="mt-8 flex flex-col justify-between gap-6 border-t border-white/15 pt-6 md:flex-row md:items-end lg:mt-10">
            <p class="animate-blur-up text-gradient-brand m-0 font-heading text-2xl font-medium tracking-tight lg:text-4xl" style="animation-delay: 1500ms">
                {about.tagline}
            </p>
            <div class="animate-blur-up flex flex-wrap items-center gap-x-8 gap-y-3 eyebrow text-swiss-white/80" style="animation-delay: 1700ms">
                <span class="flex items-center gap-2">
                    <span class="pulse-dot h-2 w-2 rounded-full bg-accent"></span>
                    Available for booking
                </span>
                {nextShow && (
                    <a href="#shows" class="group flex items-center gap-2 text-swiss-white/80 transition-colors hover:text-swiss-white no-underline">
                        Next: {formatShort(nextShow.date)} — {nextShow.venue}
                        <span class="text-accent transition-transform group-hover:translate-x-1">→</span>
                    </a>
                )}
            </div>
        </div>
    </div>
</section>
