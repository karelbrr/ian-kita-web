---
import { Image, getImage } from 'astro:assets';
import Logo from './Logo.astro';
import stage from '../assets/hero-stage-clean.jpg';
import { toLocale } from '../i18n';
import { getAbout } from '../i18n/content';

const about = getAbout(toLocale(Astro.currentLocale));

// Portrait screens only ever show the middle of this wide photo, so they get a
// full-resolution centre crop instead of a downscaled copy of the whole frame.
const portraitCrop = await getImage({
    src: stage,
    width: 1024,
    height: 1190,
    fit: 'cover',
    position: 'center',
    widths: [640, 1024],
});
---

<section id="top" class="hero relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-swiss-black">
    <div class="absolute inset-0" aria-hidden="true">
        {/* On large screens the photo is enlarged from its bottom edge so the DJ
             (centre of the frame) rises into the middle of the viewport, clear of
             the logotype that sits over the darkened lower third. Portrait screens
             zoom a little further, which also lifts the retouched spot on the LED
             wall up under the nav and its dark fade. */}
        <div class="absolute inset-0 origin-bottom scale-[1.12] portrait:scale-[1.42] lg:scale-[1.32]">
            <picture class="contents">
                <source
                    media="(orientation: portrait)"
                    srcset={portraitCrop.srcSet.attribute}
                    sizes="(min-width: 1024px) 114vh, 97vh"
                    type="image/webp"
                />
                <Image
                    src={stage}
                    alt=""
                    widths={[640, 960, 1440, 2048]}
                    sizes="(min-width: 1024px) 132vw, 112vw"
                    class="hero__img h-full w-full object-cover object-[50%_100%]"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </picture>
        </div>
        <div class="absolute inset-x-0 top-0 h-2/5 bg-gradient-to-b from-swiss-black/80 via-swiss-black/35 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-swiss-black via-swiss-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-swiss-black/40 via-transparent to-swiss-black/30"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-brand-plum/45 to-transparent"></div>
    </div>

    <div class="hero-parallax relative z-10 px-page pt-40 pb-8 lg:pb-12">
        <p class="animate-blur-up eyebrow mb-6 flex items-center gap-3 text-swiss-white/70" style="animation-delay: 1100ms">
            {about.eyebrow}
        </p>

        <h1 class="m-0 text-swiss-white">
            <span class="sr-only">Ian Kita</span>
            <Logo variant="draw" class="block h-auto w-full" decorative />
        </h1>

        <div class="mt-8 flex flex-col justify-between gap-6 border-t border-white/15 pt-6 md:flex-row md:items-end lg:mt-10">
            <p class="animate-blur-up text-gradient-brand m-0 font-heading text-2xl font-medium tracking-tight lg:text-4xl" style="animation-delay: 1500ms">
                {about.tagline}
            </p>
        </div>
    </div>
</section>
