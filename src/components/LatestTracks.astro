---
import SectionShell from "./SectionShell.astro";
import {getLatestTracks} from "../lib/soundcloudTracks";

const TRACK_COUNT = 2;

const cleanTracks = await getLatestTracks("https://soundcloud.com/iankitadj", TRACK_COUNT);
---
<SectionShell id="tracks" heading="Latest Tracks">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 ">
                {cleanTracks.map((track, i) => (
                        <div class="flex min-h-[14rem] lg:min-h-[16rem] border border-white/10 rounded-sm overflow-hidden hover:border-white/30 transition-colors">
                            <div class="flex flex-col flex-1 min-w-0 p-6 lg:p-8">
                                <span class="block font-heading text-swiss-red text-base font-medium mb-6">{String(i + 1).padStart(2, "0")}</span>
                                <h3 class="font-sans text-2xl lg:text-3xl font-medium text-swiss-white mb-6 leading-snug">{track.title}</h3>
                                <div class="flex flex-wrap gap-4 mt-auto">
                                    {track.links.spotify && (
                                        <a href={track.links.spotify} target="_blank" rel="noopener noreferrer"
                                           aria-label={`Listen to ${track.title} on Spotify`}
                                           class="text-sm font-heading uppercase tracking-widest border border-white/20 rounded-full px-5 py-2.5 text-swiss-white/80 hover:text-swiss-white hover:border-white/40 focus-visible:outline-none focus-visible:text-swiss-white focus-visible:border-white/40 focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-black transition-colors no-underline">Spotify
                                            ↗</a>
                                    )}
                                    <a href={track.links.soundcloud} target="_blank" rel="noopener noreferrer"
                                       aria-label={`Listen to ${track.title} on SoundCloud`}
                                       class="text-sm font-heading uppercase tracking-widest border border-white/20 rounded-full px-5 py-2.5 text-swiss-white/80 hover:text-swiss-white hover:border-white/40 focus-visible:outline-none focus-visible:text-swiss-white focus-visible:border-white/40 focus-visible:ring-2 focus-visible:ring-swiss-red/60 focus-visible:ring-offset-2 focus-visible:ring-offset-swiss-black transition-colors no-underline">Soundcloud
                                        ↗</a>
                                </div>
                            </div>
                            <div class="w-32 sm:w-40 lg:w-48 aspect-square shrink-0 bg-[#111]">
                                {track.cover && (
                                        <img src={track.cover} alt={`${track.title} cover art`}
                                             class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity"
                                             loading="lazy"/>
                                )}
                            </div>
                        </div>
                ))}
            </div>
</SectionShell>
