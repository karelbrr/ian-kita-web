---
import { milestones } from "../data/milestones.json";
import { festivals } from "../data/festivals.json";

const labels = "Natura Viva, Black Square Recordings, Egothermia Records, Yin Yang Records, Baikonur Records, Licker Records, Ushuaia Music.";
const residencies = "Founder of 100% Tech House and Sklep House. Ambassador for the MOAI Ecosystem.";
---

<section class="reveal col-span-1 lg:col-span-12 mb-24 lg:mb-48">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-32">
        <div class="hidden lg:block lg:col-span-3" aria-hidden="true"></div>
        <div class="col-span-1 lg:col-span-9 grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 pt-16 border-t-[1px] border-white/10">
            <div class="lg:col-span-2 flex flex-col">
                <h3
                        class="font-heading font-medium text-sm uppercase tracking-widest text-swiss-white mb-8"
                >
                    Milestones
                </h3>
                <ol class="relative border-l border-white/10 p-0 m-0 pl-8 list-none flex-1 flex flex-col justify-between">
                    {milestones.map((milestone) => (
                            <li class="relative">
                                <span class="absolute -left-[2.25rem] top-1.5 w-2 h-2 rounded-full bg-swiss-red"></span>
                                <span class="block font-heading text-swiss-red font-medium text-base mb-1">{milestone.year}</span>
                                <span class="font-sans text-swiss-white text-lg lg:text-xl">{milestone.text}</span>
                            </li>
                    ))}
                </ol>
            </div>

            <div class="lg:col-span-3">
                <h3
                        class="font-heading font-medium text-sm uppercase tracking-widest text-swiss-white mb-8"
                >
                    Festivals
                </h3>
                <ul class="flex flex-col gap-4 p-0 m-0 list-none">
                    {festivals.map((festival, i) => (
                            <li class="group flex items-center gap-5 border border-white/10 rounded-sm px-6 py-6 transition-colors hover:border-swiss-red/40 hover:bg-white/[0.02]">
                                <span class="font-heading text-swiss-red text-sm font-medium tabular-nums shrink-0">{String(i + 1).padStart(2, "0")}</span>
                                <span class="font-sans text-swiss-white text-xl lg:text-2xl font-medium">{festival.name}</span>
                                <span class="ml-auto w-2 h-2 rounded-full bg-swiss-red/0 transition-colors group-hover:bg-swiss-red"></span>
                            </li>
                    ))}
                </ul>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-12 pt-12 border-t-[1px] border-white/10">
                    <div>
                        <h3 class="font-heading font-medium text-sm uppercase tracking-widest text-swiss-white mb-4">
                            Selected Labels
                        </h3>
                        <p class="font-sans text-swiss-white/60 text-base leading-relaxed m-0">{labels}</p>
                    </div>
                    <div>
                        <h3 class="font-heading font-medium text-sm uppercase tracking-widest text-swiss-white mb-4">
                            Residencies & Projects
                        </h3>
                        <p class="font-sans text-swiss-white/60 text-base leading-relaxed m-0">{residencies}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
