---
const mixes = [
    { title: 'SYSTEM OVERRIDE', duration: '45:20' },
    { title: 'VOID TRANSMISSION', duration: '58:10' },
    { title: 'NEON SHADOWS', duration: '62:00' }
];
---
<section class="col-span-1 lg:col-span-12 mb-24 lg:mb-48">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-32">
    <h2 class="col-span-1 lg:col-span-3 font-heading font-medium text-lg uppercase tracking-widest text-swiss-white mt-1">Mixes & Sets</h2>
    <div class="col-span-1 lg:col-span-9">
      <ul class="list-none p-0 m-0 border-t-[1px] border-white/10">
        {mixes.map(mix => (
          <li class="flex justify-between items-center py-6 border-b-[1px] border-white/10 font-sans text-lg lg:text-xl text-swiss-white hover:text-swiss-white transition-colors cursor-pointer">
            <span class="font-medium">{mix.title}</span>
            <span class="text-right text-sm text-swiss-white">{mix.duration}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
