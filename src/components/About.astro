---
import {Image} from 'astro:assets';
import about from '../data/about.json';
import photo from '../assets/photos/machac-2026-decks.jpg';
---

<section id="about" class="reveal relative px-6 py-24 md:px-12 lg:px-24 lg:py-40">
    <div class="pointer-events-none absolute -top-32 right-0 h-[44rem] w-[44rem] translate-x-1/3 rounded-full bg-[radial-gradient(closest-side,var(--color-brand-purple),transparent)] opacity-50"
         aria-hidden="true"></div>
    <div class="relative grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
            <figure class="relative m-0 aspect-[4/5] overflow-hidden rounded-sm bg-ink lg:sticky lg:top-28">
                {/* The 2:3 photo is cropped to the 4:5 frame from 35% down, which keeps
                     the MÁCHÁČ watermark (bottom-right corner) outside the frame. */}
                <Image
                        src={photo}
                        alt="Ian Kita mixing on Pioneer decks in the sun at Mácháč 2026"
                        widths={[480, 800, 1200, 1365]}
                        sizes="(min-width: 1024px) 40vw, 100vw"
                        class="h-full w-full object-cover object-[50%_35%]"
                        loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-swiss-black/60 via-transparent to-transparent"></div>
                <figcaption class="absolute bottom-4 left-4 flex items-center gap-2 eyebrow text-swiss-white/80">
                    Jan Zelinger · Ian Kita
                </figcaption>
            </figure>
        </div>

        <div class="lg:col-span-7 lg:pl-8">
            <h2 class="eyebrow mb-8 text-accent">About</h2>
            <p class="mb-10 font-heading text-3xl leading-[1.05] tracking-tight text-balance text-swiss-white sm:text-4xl lg:text-5xl">
                {about.lead}
            </p>
            <div class="stagger max-w-2xl space-y-6 text-lg leading-relaxed text-swiss-white/70 lg:text-xl">
                {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <blockquote class="mt-14 border-l-2 border-accent pl-6 lg:pl-8">
                <p class="m-0 font-heading text-2xl leading-snug tracking-tight text-swiss-white lg:text-3xl">
                    “{about.quote}”</p>
                <footer class="eyebrow mt-4 text-swiss-white/50">{about.quoteSource}</footer>
            </blockquote>

            {/*
            <dl class="stagger mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-sm border border-white/10 bg-white/10 sm:grid-cols-3">
                {about.stats.map((stat) => (
                        <div class="flex flex-col-reverse bg-swiss-black p-6 lg:p-8">
                            <dt class="eyebrow text-swiss-white/50">{stat.label}</dt>
                            <dd class="m-0 mb-3 font-heading text-4xl tracking-tighter text-swiss-white lg:text-5xl">{stat.value}</dd>
                        </div>
                ))}
            </dl>
            */}
        </div>
    </div>
</section>
