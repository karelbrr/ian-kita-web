---
import Layout from "../layouts/Layout.astro";
---

<Layout title="IAN KITA | Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <h1 class="font-heading font-bold text-7xl md:text-8xl tracking-tighter text-swiss-white mb-6">404</h1>
    <p class="font-sans text-swiss-white/60 text-base mb-10">This page doesn't exist.</p>
    <a
      href="/"
      class="inline-block text-xs font-heading font-medium text-swiss-white/60 hover:text-swiss-white uppercase tracking-widest transition-colors no-underline"
    >
      &larr; Back to Home
    </a>
  </div>
</Layout>
