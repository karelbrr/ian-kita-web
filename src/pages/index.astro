---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Gigs from "../components/Gigs.astro";
import LatestTracks from "../components/LatestTracks.astro";
import Mixes from "../components/Mixes.astro";
import Gallery from "../components/Gallery.astro";
import Booking from "../components/Booking.astro";
---

<Layout title="IAN KITA | Swiss Design (Tailwind)">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-full items-start px-6 md:px-12 lg:px-24 py-12 lg:py-24">
    <Hero />
    <About />
    <Gigs />
    <LatestTracks />
    <Mixes />
    <Gallery />
    <Booking />
  </div>
</Layout>
