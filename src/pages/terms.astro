---
import Layout from "../layouts/Layout.astro";
---

<Layout title="IAN KITA | Terms of Service">
    <div class="px-6 md:px-12 lg:px-24 py-24 lg:py-32 min-h-screen">
        <div class="max-w-4xl">
            <a
                    href="/"
                    class="inline-block mb-16 text-xs font-heading font-medium text-swiss-white/60 hover:text-swiss-white uppercase tracking-widest transition-colors"
            >
                &larr; Back to Home
            </a>

            <h1
                    class="font-heading font-bold text-5xl md:text-7xl tracking-tighter leading-[0.9] mb-16 text-swiss-white uppercase"
            >
                Terms of Service
            </h1>

            <div class="prose prose-invert prose-lg max-w-none font-sans text-swiss-white/80 leading-relaxed">
                <p class="mb-8">Last updated: {new Date().toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric'
                })}</p>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">1.
                        Agreement to Terms</h2>
                    <p class="mb-4">
                        By accessing and using this website, you accept and agree to be bound by the terms and provision
                        of this agreement. If you do not agree to abide by the above, please do not use this service.
                    </p>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">2.
                        Intellectual Property Rights</h2>
                    <p class="mb-4">
                        The Site and its original content, features, audio, visual media, and functionality are owned by
                        Ian Kita and are protected by international copyright, trademark, patent, trade secret, and
                        other intellectual property or proprietary rights laws.
                    </p>
                    <p class="mb-4">
                        You may not download, copy, reproduce, distribute, transmit, broadcast, display, sell, license,
                        or otherwise exploit any content for any other purposes without the prior written consent of Ian
                        Kita or the respective licensors of the content.
                    </p>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">3. User
                        Conduct</h2>
                    <p class="mb-4">
                        As a condition of use, you promise not to use the Services for any purpose that is unlawful or
                        prohibited by these Terms, or any other purpose not reasonably intended by Ian Kita. By way of
                        example, and not as a limitation, you agree not to use the Services to:
                    </p>
                    <ul class="list-disc pl-6 mb-4 space-y-2">
                        <li>Abuse, harass, threaten, impersonate or intimidate any person.</li>
                        <li>Post or transmit any content that is infringing, libelous, defamatory, obscene,
                            pornographic, abusive, offensive, profane, or otherwise violates any law or right of any
                            third party.
                        </li>
                        <li>Attempt to access or search the Site or download content from the Site through the use of
                            any engine, software, tool, agent, device or mechanism.
                        </li>
                    </ul>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">4.
                        Booking and Services</h2>
                    <p class="mb-4">
                        Any booking inquiries made through this website are subject to availability and further written
                        agreement. Submitting an inquiry does not constitute a confirmed booking or contract. All
                        performance terms, riders, and technical requirements will be negotiated separately.
                    </p>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">5.
                        Limitation of Liability</h2>
                    <p class="mb-4">
                        In no event shall Ian Kita, nor his directors, employees, partners, agents, suppliers, or
                        affiliates, be liable for any indirect, incidental, special, consequential or punitive damages,
                        including without limitation, loss of profits, data, use, goodwill, or other intangible losses,
                        resulting from your access to or use of or inability to access or use the Service.
                    </p>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">6.
                        Changes to Terms</h2>
                    <p class="mb-4">
                        We reserve the right, at our sole discretion, to modify or replace these Terms at any time. What
                        constitutes a material change will be determined at our sole discretion. By continuing to access
                        or use our Service after those revisions become effective, you agree to be bound by the revised
                        terms.
                    </p>
                </section>

                <section class="mb-12">
                    <h2 class="font-heading font-bold text-2xl tracking-tight text-swiss-white uppercase mb-4">7.
                        Contact Us</h2>
                    <p class="mb-4">
                        If you have any questions about these Terms, please contact us via the booking form on the home
                        page or email at contact@ian-kita.com.
                    </p>
                </section>
            </div>
        </div>
    </div>
</Layout>
