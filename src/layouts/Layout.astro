---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import LogoDefs from '../components/LogoDefs.astro';
import {DEFAULT_LOCALE, LANGUAGES, otherLocale, toLocale, translatedPath} from '../i18n';
import {getDictionary} from '../i18n/ui';

export interface Props {
    title: string;
    description?: string;
    image?: string;
    /** This page in the other language. Defaults to the same path with or without /cs. */
    alternatePath?: string;
    /** False for pages without a translated counterpart (the 404 page): no hreflang links. */
    translated?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const other = otherLocale(locale);
const t = getDictionary(locale);

const {
    title,
    description = t.meta.description,
    image = '/og-image.png',
    alternatePath = translatedPath(Astro.url.pathname, other),
    translated = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = new URL(alternatePath, Astro.site);
const defaultLanguageURL = locale === DEFAULT_LOCALE ? canonicalURL : alternateURL;
const ogImageURL = new URL(image, Astro.site);

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'MusicGroup',
    name: 'Ian Kita',
    alternateName: ['Jan Zelinger', 'DJ Kita'],
    genre: ['Techno', 'Tech House'],
    url: Astro.site?.toString(),
    image: ogImageURL.toString(),
    logo: new URL('/icon-512.png', Astro.site).toString(),
    foundingDate: '1999',
    foundingLocation: {
        '@type': 'Place',
        name: 'Zlín, Czech Republic',
    },
    sameAs: [
        'https://www.instagram.com/dj_ian_kita/',
        'https://soundcloud.com/iankitadj',
        'https://open.spotify.com/artist/5O53OdbKPbycjdfysY4Oyt',
    ],
    contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'booking',
        email: 'booking@iankita.com',
    },
};
---

<!DOCTYPE html>
<html lang={LANGUAGES[locale].hreflang}>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonicalURL}/>
    {translated && (
        <>
            <link rel="alternate" hreflang={LANGUAGES[locale].hreflang} href={canonicalURL}/>
            <link rel="alternate" hreflang={LANGUAGES[other].hreflang} href={alternateURL}/>
            <link rel="alternate" hreflang="x-default" href={defaultLanguageURL}/>
        </>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <meta name="theme-color" content="#000000"/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Ian Kita"/>
    <meta property="og:locale" content={LANGUAGES[locale].ogLocale}/>
    <meta property="og:locale:alternate" content={LANGUAGES[other].ogLocale}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={ogImageURL}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:url" content={canonicalURL}/>

    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImageURL}/>

    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>
</head>
<body>
<a href="#main" class="skip-link eyebrow">{t.skipLink}</a>
<div class="scroll-progress" aria-hidden="true"></div>
<LogoDefs/>
<Nav alternatePath={alternatePath}/>
<main id="main" tabindex="-1" class="relative z-10 min-h-screen overflow-x-clip">
    <slot/>
</main>
<div class="grain" aria-hidden="true"></div>
<script src="../scripts/main.ts"></script>
</body>
</html>
