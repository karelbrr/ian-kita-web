---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import LogoDefs from '../components/LogoDefs.astro';

export interface Props {
    title: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = 'Ian Kita — techno & tech house DJ and producer from Zlín, Czech Republic. Upcoming shows, latest releases, photos and booking.',
    image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'MusicGroup',
    name: 'Ian Kita',
    alternateName: ['Jan Zelinger', 'DJ Kita'],
    genre: ['Techno', 'Tech House'],
    url: Astro.site?.toString(),
    image: ogImageURL.toString(),
    logo: new URL('/icon-512.png', Astro.site).toString(),
    foundingDate: '1999',
    foundingLocation: {
        '@type': 'Place',
        name: 'Zlín, Czech Republic',
    },
    sameAs: [
        'https://www.instagram.com/dj_ian_kita/',
        'https://soundcloud.com/iankitadj',
        'https://open.spotify.com/artist/5O53OdbKPbycjdfysY4Oyt',
    ],
    contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'booking',
        email: 'booking@iankita.com',
    },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonicalURL}/>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <meta name="theme-color" content="#000000"/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Ian Kita"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={ogImageURL}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:url" content={canonicalURL}/>

    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImageURL}/>

    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
        if (window.netlifyIdentity) {
            window.netlifyIdentity.on("init", (user) => {
                if (!user) {
                    window.netlifyIdentity.on("login", () => {
                        document.location.href = "/admin/";
                    });
                }
            });
        }
    </script>
</head>
<body>
<div class="scroll-progress" aria-hidden="true"></div>
<LogoDefs/>
<Nav/>
<main class="relative z-10 min-h-screen overflow-x-clip">
    <slot/>
</main>
<div class="grain" aria-hidden="true"></div>
<script src="../scripts/main.ts"></script>
</body>
</html>
